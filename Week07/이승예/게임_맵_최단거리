import java.util.*;

class Solution {
    public int solution(int[][] maps) {
        Queue<int[]> queue = new ArrayDeque<>();
        queue.add(new int[]{0,0}); // 시작 위치 (0,0) 넣기
        
        // 맵의 세로 길이 (행 개수)
        int n = maps.length;
        
        // 맵의 가로 길이 (열 개수)
        int m = maps[0].length;
        
        // 아래, 위, 오른쪽, 왼쪽
        int[] dx = {1, -1, 0, 0};
        int[] dy = {0, 0, 1, -1};
        
        while(!queue.isEmpty()) {
            
            int[] cur = queue.poll();
            
            int x = cur[0];
            int y = cur[1];
            
            // 4방향 탐색
            for(int i = 0; i < 4; i++) {
                
                // 다음 이동할 좌표
                int nx = x + dx[i];
                int ny = y + dy[i];
                
                // 맵 범위 벗어나면 이동 불가
                if(nx < 0 || ny < 0 || nx >= n || ny >= m) continue;
            
                // 벽인지 확인
                if(maps[nx][ny] == 0) continue;
                
                // 이미 방문한 칸인지 확인
                if(maps[nx][ny] != 1) continue;
                
                // 현재 위치 거리 +1 저장
                maps[nx][ny] = maps[x][y] + 1;
                
                queue.add(new int[]{nx,ny});
            }
        }
        // 도착 못한 경우
        if(maps[n-1][m-1] == 1) return -1;
        return maps[n-1][m-1];
    }
}
